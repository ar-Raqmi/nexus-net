# Required: Gemini API key (server-only, never commit real values)
GEMINI_API_KEY=your_key_here
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional, testing only: route Gemma through OpenRouter instead of the Gemini API.
# Set GEMMA_PROVIDER=openrouter, fill OPENROUTER_API_KEY, and use an OpenRouter model id
# (e.g. GEMMA_MODEL=google/gemma-4-31b-it).
# GEMMA_PROVIDER=
# OPENROUTER_API_KEY=
